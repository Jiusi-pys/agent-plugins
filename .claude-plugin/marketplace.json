{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "jiusi-agent-plugins",
  "owner": {
    "name": "九思"
  },
  "metadata": {
    "description": "OpenHarmony/KaihongOS software porting workflow",
    "version": "1.2.0"
  },
  "plugins": [
    {
      "name": "auto-clean",
      "description": "Auto-cleans Claude Code tracking data and privacy information. Supports init reset, deep clean, and automatic cleanup on exit.",
      "version": "1.0.0",
      "author": {
        "name": "九思"
      },
      "source": "./plugins/auto-clean",
      "category": "utility",
      "tags": ["privacy", "cleanup", "telemetry", "security"],
      "homepage": "https://github.com/Jiusi-pys/agent-plugins/tree/main/plugins/auto-clean",
      "license": "MIT"
    },
    {
      "name": "multi-review",
      "description": "异质多感知代码审查流水线：确定性 preflight → 风险路由 → 并行只读 sensor → 独立反证 → 统一裁决。不做多数投票，只有已验证的问题才阻断，绝不自动改码或合并。",
      "version": "1.0.0",
      "author": {
        "name": "九思"
      },
      "source": "./plugins/multi-review",
      "category": "development",
      "tags": ["code-review", "review", "subagents", "workflow", "verification", "security"],
      "homepage": "https://github.com/Jiusi-pys/agent-plugins/tree/main/plugins/multi-review",
      "license": "MIT"
    },
    {
      "name": "weread-exporter",
      "description": "Export personally authorized WeRead books to Markdown with inline illustrations.",
      "version": "1.0.0",
      "author": {"name": "Jiusi-pys"},
      "source": "./plugins/weread-exporter",
      "category": "productivity",
      "tags": ["weread", "wechat-reading", "markdown", "playwright", "export"],
      "homepage": "https://github.com/Jiusi-pys/agent-plugins/tree/openai/plugins/weread-exporter"
    }
  ]
}
